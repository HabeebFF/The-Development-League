# Copy to .env and fill in. Never commit the real .env.
# 50+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me
# Optional separate key for sign-in tokens (defaults to DJANGO_SECRET_KEY)
JWT_SIGNING_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://tdl:tdl@localhost:5432/tdl
REDIS_URL=redis://localhost:6379/0
TIME_ZONE=UTC
# Time zone of the observer PC that writes the logs (times in the logs have no zone).
LOG_TIME_ZONE=Africa/Lagos
# S3 (production). Leave USE_S3=false to store uploads on disk.
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOAD_MAX_FILE_BYTES=314572800
# Website address used in invite and password-reset emails
FRONTEND_URL=http://localhost:3000
# Cookies: set AUTH_COOKIE_DOMAIN=.yourdomain.com when the API and site are subdomains
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_DOMAIN=
# Email (e.g. AWS SES SMTP). The console backend just prints emails.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=The Development League <no-reply@example.com>
