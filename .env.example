# Copy to .env and fill in. Never commit the real .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DATABASE_URL=postgres://tdl:tdl@localhost:5432/tdl
REDIS_URL=redis://localhost:6379/0
TIME_ZONE=UTC
# Time zone of the observer PC that writes the logs (times in the logs have no zone).
LOG_TIME_ZONE=Africa/Lagos
# S3 (production). Leave USE_S3=false to store uploads on disk.
USE_S3=false
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
UPLOAD_MAX_FILE_BYTES=314572800
